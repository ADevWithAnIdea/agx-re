+def cohort_of(fn, rec):
+    """emitter-grade | withdrawn | None(skip).  A `withdrawn` row is one this repo
+    demoted to `untested` on EXP-0164's or EXP-0189's re-derivation -- exactly the set
+    the underscore refilter could legitimately give back."""
+    if fn.startswith("_"):
+        return None
+    lab = rec.get("label")
+    if lab in EMIT_OK:
+        return "emitter-grade"
+    if lab == "untested" and WITHDRAWN_NOTE.search(str(rec.get("note") or "")):
+        return "withdrawn"
+    return None
+
