===== ADD<->SUB: locate the negate that turns a+b into a-b/b-a =====
iadd ALU = 9f015600020800a81705
  base a+b        out=[13, 7, -7, -13]  exp [13, 7, -7, -13]
  b0&0x7f (0x1f)  out=[-7, -13, 13, 7]  exp b-a [-7, -13, 13, 7]  PASS
  isub-form       out=[7, 13, -13, -7]  exp a-b [7, 13, -13, -7]  PASS

