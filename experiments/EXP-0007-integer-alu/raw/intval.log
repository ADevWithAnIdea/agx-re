  imin  b4=0x07  out=[-5, -6, -1, -8]  exp=[-5, -6, -1, -8]  PASS
  umin  b4=0x05  out=[3, 100, 2, 7]  exp=[3, 100, 2, 7]  PASS
  imax  b4=0x06  out=[3, 100, 2, 7]  exp=[3, 100, 2, 7]  PASS
  umax  b4=0x04  out=[-5, -6, -1, -8]  exp=[-5, -6, -1, -8]  PASS
  splice imin b4 clear bit1 -> unsigned min  out=[3, 100, 2, 7] exp=[3, 100, 2, 7] PASS

