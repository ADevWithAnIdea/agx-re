    j13=j13*t+j14;
    j14=j14*t+j15;
    j15=j15*t+j16;
    j16=j16*t+j17;
    j17=j17*t+j18;
    j18=j18*t+j19;
    j19=j19*t+j20;
    j20=j20*t+j21;
    j21=j21*t+j22;
    j22=j22*t+j23;
    j23=j23*t+j0;
  }
  out[1+0]=j0;
  out[1+1]=j1;
  out[1+2]=j2;
  out[1+3]=j3;
  out[1+4]=j4;
