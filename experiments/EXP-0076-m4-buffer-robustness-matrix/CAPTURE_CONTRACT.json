    "store_rule": "S(j) = (0xC7 + j) mod 256 for j in 0..15 (store value bytes, in order)"
  },
  "hypotheses": {
    "H1_MEM06": "unaligned loads return the exact in-bounds fill bytes at the access window, no fault, no buffer change",
    "H2_MEM07": "unaligned stores write exactly the frozen pattern bytes and leave every other allocation byte unchanged",
    "H3_MEM08": "out-of-allocation reads return the uniform value 0x00 for every tested width and alignment",
    "H4_MEM09": "boundary-straddling reads return the per-component mix (in-bounds fill + 0x00 OOB tail)",
    "H5_MEM10": "out-of-allocation stores are discarded (allocation and all guard regions unchanged) or corrupt a recordable neighbor",
    "stretch_atomic": "32-bit atomic_exchange_explicit exchanges the pre-existing word out / writes the pattern word in, with the same zero/discard expectations at offset 64"
  },
