# Build artifacts — compiled Metal archives, per-category extractor binaries, and
# per-compile logs. All reproducible from the committed .metal sources + shdump.
# Clean-room: commit only our own MSL source and the extracted AGX hex/text.
*.bin
# work/ holds build artifacts + per-family scratch DBs/patches — commit only census/gap records
work/*
!work/*census*.txt
!work/*gaps*.json
# stray per-agent scratch work dirs (work_nf, work_nb, ...) — never commit
work_*/
# bulk extracted third-party AGX hex (reproducible from thirdparty/ source + shdump) — coverage evidence is the census record
thirdparty_hex/
