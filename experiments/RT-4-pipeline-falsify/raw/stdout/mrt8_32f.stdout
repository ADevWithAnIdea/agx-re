DEVICE Apple A18 Pro
CONFIG w=64 h=64 vp=(64,64) fmt=rgba32f mrtfmt=(same) bpp=16 samples=1 sampos=0 mrt=8 depth=0 stencil=0 mldepth=0 mlcolor=0 nocolor=0 load=clear store=store dload=clear dstore=dontcare
VA rtBuf        = 0x0000010000058000  le=0080050000010000
VA vtxBuf       = 0x000001000001c500  le=00c5010000010000
SUBMIT iter=0 begin
SUBMIT iter=0 done status=4 err=none
PIXEL b0..3=0000803d
