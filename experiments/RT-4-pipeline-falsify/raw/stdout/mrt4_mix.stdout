DEVICE Apple A18 Pro
CONFIG w=64 h=64 vp=(64,64) fmt=bgra8 mrtfmt=bgra8,rgba32f,r8,rgba16f bpp=4 samples=1 sampos=0 mrt=4 depth=0 stencil=0 mldepth=0 mlcolor=0 nocolor=0 load=clear store=store dload=clear dstore=dontcare
VA rtBuf        = 0x0000010000058000  le=0080050000010000
VA vtxBuf       = 0x000001000001d600  le=00d6010000010000
SUBMIT iter=0 begin
SUBMIT iter=0 done status=4 err=none
PIXEL b0..3=30201040
