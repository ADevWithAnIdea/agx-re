DEVICE Apple A18 Pro
CONFIG w=64 h=64 vp=(64,64) fmt=rgba32f mrtfmt=(same) bpp=16 samples=4 sampos=0 mrt=1 depth=0 stencil=0 mldepth=0 mlcolor=0 nocolor=0 load=clear store=store dload=clear dstore=dontcare
VA resBuf       = 0x00000100000c8000  le=00800c0000010000
VA vtxBuf       = 0x000001000001c500  le=00c5010000010000
SUBMIT iter=0 begin
SUBMIT iter=0 done status=4 err=none
PIXEL b0..3=0000803e
