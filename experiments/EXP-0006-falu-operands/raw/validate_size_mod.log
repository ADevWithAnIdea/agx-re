
===== SIZE bit (operand bit0): 32-bit vs 16-bit-half read =====
base ALU @0x20 = 09011c0500c0  srcA=b1=0x1 srcB=b3=0x5
  a = [1.1, 2.2, 3.3, 4.4]
  ref a low-half  as f16: [-19.20312, -19.20312, 0.22498, -19.20312]
  ref a high-half as f16: [1.88672, 2.02344, 2.16211, 2.27344]
  srcA 32-bit  (b1|1): b1=0x01 out=[1.1, 2.2, 3.3, 4.4]
  srcA 16-bit lo (b1&~3): b1=0x00 out=[-19.20312, -19.20312, 0.22498, -19.20312]
  srcA 16-bit hi (b1&~1|2): b1=0x02 out=[0.0, 0.0, 0.0, 0.0]

===== MODIFIERS: negate (6B, b5 bit3) & abs (10B) with signed inputs =====
  add ALU=09011c0500c0  A=[10.0, 10.0, -10.0, -10.0] B=[3.0, -3.0, 3.0, -3.0]
  base (a+b)          out=[13.0, 7.0, -7.0, -13.0]  exp [13.0, 7.0, -7.0, -13.0]
  splice b5|0x08(a-b) out=[7.0, 13.0, -13.0, -7.0]  exp [7.0, 13.0, -13.0, -7.0]  PASS
  absb ALU=09011c05020000800200 (10B)  A=[10.0, 10.0, -10.0, -10.0] B=[3.0, -3.0, 3.0, -3.0]
  base (a+|b|)        out=[13.0, 13.0, -7.0, -7.0]  exp [13.0, 13.0, -7.0, -7.0]  PASS
  splice b5|0x08      out=[7.0, 7.0, -13.0, -13.0]  exp a-|b| [7.0, 7.0, -13.0, -13.0]  PASS
