DEVICE Apple A18 Pro
CONFIG w=64 h=64 vp=(64,64) verts=3 prim=tri inst=1 fmt=bgra8 bpp=4 indexed=0 blend=0 depth=1 vsh=small fsh=small two=0 iters=1 rtbuf=1
VA rtBuf        = 0x0000010000058000  le=0080050000010000
VA vtxBuf       = 0x000001000001c500  le=00c5010000010000
SUBMIT iter=0 begin
SUBMIT iter=0 done status=4
