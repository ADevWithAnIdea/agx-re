DEVICE Apple A18 Pro
DISPATCH grid=64 tg=32 iters=1
VA bufA       = 0x0000010000030000  le=0000030000010000
VA bufB       = 0x0000010000030100  le=0001030000010000
VA bufOut     = 0x0000010000030200  le=0002030000010000
SUBMIT iter=0 begin
SUBMIT iter=0 done status=4
RESULT o[0]=1000.5 o[1]=1001.5 (expect 1000.5 1001.5)
