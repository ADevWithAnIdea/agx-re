DEVICE Apple A18 Pro
CONFIG w=128 h=128 vp=(128,128) verts=3 prim=tri inst=1 fmt=bgra8 bpp=4 indexed=0 blend=0 depth=0 vsh=small fsh=small two=0 iters=1 rtbuf=1
VA rtBuf        = 0x0000010000058000  le=0080050000010000
VA vtxBuf       = 0x0000010000018700  le=0087010000010000
SUBMIT iter=0 begin
SUBMIT iter=0 done status=4
PIXEL b0..3=bf8040ff
