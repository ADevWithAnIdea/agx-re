DEVICE Apple A18 Pro
CONFIG type=2d fmt=rgba8unorm W=4 H=4 D=1 mips=1 arraylen=1 samples=1 texoff=-1 cmp=0
SMPCFG minf=nearest magf=nearest mipf=none saddr=edge taddr=edge raddr=edge cmpf=never border=tblack aniso=2 lodmin=0 lodmax=-1 norm=1
TEX ok type=2d fmt=rgba8unorm
SMP ok
VA obuf         = 0x000001000001c600  le=00c6010000010000
SUBMIT done status=4
