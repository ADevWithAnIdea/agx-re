DEVICE Apple A18 Pro
CONFIG type=2d fmt=rgba8unorm W=4 H=4 D=1 mips=1 arraylen=1 samples=1 texoff=40960 cmp=0
SMPCFG minf=nearest magf=nearest mipf=none saddr=edge taddr=edge raddr=edge cmpf=never border=tblack aniso=1 lodmin=0 lodmax=-1 norm=1
VA texbuf       = 0x0000010000018000  le=0080010000010000
TEXBUF base+off = 0x10000022000 (off=0xa000 bpr=0x40 align=0x10)
TEX ok type=2d fmt=rgba8unorm
SMP ok
VA obuf         = 0x0000010000030700  le=0007030000010000
SUBMIT done status=4
