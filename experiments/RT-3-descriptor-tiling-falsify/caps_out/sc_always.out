DEVICE Apple A18 Pro
CONFIG type=2d fmt=depth32float W=4 H=4 D=1 mips=1 arraylen=1 samples=1 texoff=-1 cmp=1
SMPCFG minf=nearest magf=nearest mipf=none saddr=edge taddr=edge raddr=edge cmpf=always border=tblack aniso=1 lodmin=0 lodmax=-1 norm=1
TEX ok type=2d fmt=depth32float
SMP ok
VA obuf         = 0x000001000001c600  le=00c6010000010000
SUBMIT done status=4
