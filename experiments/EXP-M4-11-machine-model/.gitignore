# Clean-room: never commit compiled binaries, archives, or Apple-managed blobs.
# raw/ text logs and *.m/*.py/*.metal sources ARE committed (our own data/code).
work/
*.bin
*.hex
*.metallib
harness/shdump
harness/agxrun
harness/agxrun_persist
harness/agxrender
harness/attrdump
harness/dvar11
harness/*.dylib
**/__pycache__/
*.pyc
