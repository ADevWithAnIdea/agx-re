DEVICE Apple M4
CONFIG w=64 h=64 vp=(64,64) fmt=bgra8 bpp=4 samples=1 sampos=0 mrt=1 depth=0 stencil=0 mldepth=0 mlcolor=0 nocolor=0 load=clear store=store dload=clear dstore=dontcare
VA rtBuf        = 0x0000010000058000  le=0080050000010000
VA vtxBuf       = 0x0000010000018700  le=0087010000010000
SUBMIT iter=0 begin
SUBMIT iter=0 done status=4 err=none
PIXEL b0..3=bf8040ff
