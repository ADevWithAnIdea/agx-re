# Never commit Apple proprietary artifacts pulled from the device.
# (Our own shader source/disassembly and non-copyrightable data traces are fine — add explicitly.)
*.metallib
*.dylib
*.kext/
*.air
scratch/
__pycache__/
*.pyc
# built harness binaries (rebuild from source; never committed)
tools/agxtest/agxrun
tools/agxtest/agxrun_persist
tools/agxtest/agxtest
tools/agxtest/shdump
tools/agxtest/agxrender
tools/**/*.dylib
experiments/**/shdump
experiments/**/*.bin
# stray splice inputs / compiled shader blobs dropped at repo root by the harness
/*.bin
**/.DS_Store
tools/agxtest/agxparse.py
experiments/EXP-M4-01-isa-census/census/shdump
experiments/EXP-M4-01-isa-census/census/*.bin
# bulk timestamp-scan dumps (reproducible; archived out of the repo) — never commit
experiments/**/tsscan.txt
experiments/**/*.tsscan
